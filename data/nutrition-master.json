  "lighterChoicesTips": [
    {
      "title": "Opt for Super Greens as your Side",
      "text": "Swapping Chow Mein (510 cal) or Fried Rice (520 cal) for Super Greens (90 cal) immediately trims over 400 calories from your meal while adding dietary fiber, vitamin A, and vitamin C."
    },
    {
      "title": "Pair Grilled Teriyaki Chicken with Broccoli Beef",
      "text": "This power combination gives you 42g of high-quality protein for only 425 total entree calories. Ask for the teriyaki sauce on the side to control extra sugars."
    },
    {
      "title": "Split Your Side Fifty-Fifty",
      "text": "Can't give up noodles? Panda Express lets you order half Super Greens and half Chow Mein or Brown Rice. This cuts carb heaviness in half while keeping the satisfying texture you crave."
    },
    {
      "title": "Watch Out for Sugary Sauces and Tempura Batters",
      "text": "Deep-fried entrees coated in glaze (like Orange Chicken and Beijing Beef) contain higher fat and carb counts. Enjoy them as treats or balance them with crisp steamed veggies."
    }
  ],
