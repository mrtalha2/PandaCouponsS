# ==============================================================================
# Panda Express Coupons - Environment Variables Configuration
# ==============================================================================
# Generate these values using:
#   node scripts/generate-admin-hash.js
# ==============================================================================

# Administrator Credentials
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=<run node scripts/generate-admin-hash.js to generate hash>
SESSION_SECRET=<run node scripts/generate-admin-hash.js to generate secret>

# Server Configuration
PORT=3000
NODE_ENV=production
