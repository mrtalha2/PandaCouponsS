{
  "name": "panda-express-coupons",
  "version": "1.0.0",
  "description": "Fast, SEO-optimized static coupon and menu site for Panda Express deals",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node scripts/run-all-tests.js",
    "release": "zip -q -r release-pandacoupons.zip . -x '*.git*' '*node_modules*' '*.env*' '*.DS_Store*' '*__MACOSX*' '*data/admin/.sessions.json*' '*data/admin/backups/*' '*assets-src/*' '*release-pandacoupons.zip*'",
    "verify": "node scripts/verify-site-remediation.js",
    "optimize-images": "node scripts/optimize-images.js",
    "generate-og": "node scripts/generate-og-images.js"
  },
  "keywords": [
    "coupons",
    "panda-express",
    "deals",
    "nutrition",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "sanitize-html": "^2.17.5",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "sharp": "^0.35.4",
    "terser": "^5.51.2"
  }
}
